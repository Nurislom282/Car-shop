<%- include('../includes/header') %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/signup.css" />

    <body>
        <div class="signup-glass-container-moder">
            <div class="animated-bg-signup-moder">
                <div class="gradient-blob-m blob-1"></div>
                <div class="gradient-blob-m blob-2"></div>
                <div class="gradient-blob-m blob-3"></div>
            </div>

            <div class="signup-glass-card-moder">
                <div class="signup-header-moder">
                    <div class="logo-circle-moder">
                        <svg width="40" height="40" fill="white" viewBox="0 0 24 24">
                            <path
                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                        </svg>
                    </div>
                    <h1>Join as Moderator</h1>
                    <p>Create your account and start managing events</p>
                </div>

                <form onsubmit="return validateSignupForm()" action="/moderator/signup" method="POST"
                    enctype="multipart/form-data" class="signup-form-moder">
                    <div class="form-grid-moder">
                        <div class="input-group-glass-moder">
                            <label>Username *</label>
                            <input type="text" name="memberNick" placeholder="Choose a username" required
                                class="glass-input-moder member-nick" />
                        </div>

                        <div class="input-group-glass-moder">
                            <label>Phone Number *</label>
                            <input type="text" name="memberPhone" placeholder="Enter phone number" required
                                class="glass-input-moder member-phone" />
                        </div>

                        <div class="input-group-glass-moder">
                            <label>Password *</label>
                            <input type="password" name="memberPassword" placeholder="Create password" required
                                class="glass-input-moder member-password" />
                        </div>

                        <div class="input-group-glass-moder">
                            <label>Confirm Password *</label>
                            <input type="password" name="confirmPassword" placeholder="Repeat password" required
                                class="glass-input-moder confirm-password" />
                        </div>
                    </div>

                    <div class="upload-section-moder">
                        <label>Profile Image</label>
                        <div class="upload-area-moder" id="uploadArea">
                            <svg width="40" height="40" fill="rgba(255,255,255,0.6)" viewBox="0 0 24 24">
                                <path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" />
                            </svg>
                            <p>Click to upload or drag and drop</p>
                            <span>PNG, JPG or JPEG (max. 5MB)</span>
                            <input type="file" id="memberImage" name="memberImage"
                                accept="image/jpeg,image/jpg,image/png" class="member-image" />
                        </div>
                        <div class="image-preview-moder" id="imagePreview" style="display: none;">
                            <img src="" alt="Preview" id="previewImg">
                            <button type="button" class="remove-btn-moder" id="removeBtn">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path
                                        d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="benefits-box">
                        <h3>Moderator Benefits</h3>
                        <ul>
                            <li>
                                <svg width="20" height="20" fill="#38ef7d" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                                </svg>
                                Full event management control
                            </li>
                            <li>
                                <svg width="20" height="20" fill="#38ef7d" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                                </svg>
                                Advanced analytics dashboard
                            </li>
                            <li>
                                <svg width="20" height="20" fill="#38ef7d" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                                </svg>
                                Priority customer support
                            </li>
                        </ul>
                    </div>

                    <input name="memberType" value="MODERATOR" hidden />

                    <label class="checkbox-label-moder">
                        <input type="checkbox" required>
                        <span>I agree to the Terms of Service and Privacy Policy</span>
                    </label>

                    <button type="submit" class="submit-btn-moder">
                        <span>Create Account</span>
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                        </svg>
                    </button>
                </form>

                <div class="signup-footer-moder">
                    <p>Already have an account? <a href="/admin/login">Login in</a></p>
                    <a href="/admin" class="back-link-moder">← Back to Home</a>
                </div>
            </div>
        </div>

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                overflow-y: auto;
                min-height: 100vh;
                background: linear-gradient(135deg, #3ccbffb1 0%, #a24bff 100%);
            }

            .signup-glass-container-moder {
                position: relative;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
            }

            .animated-bg-signup-moder {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 0;
            }

            .gradient-blob-m {
                position: absolute;
                border-radius: 50%;
                filter: blur(90px);
                opacity: 0.5;
                animation: blob-float 20s ease-in-out infinite;
            }

            .blob-1 {
                width: 450px;
                height: 450px;
                background: radial-gradient(circle, #06beb6 0%, transparent 70%);
                top: -100px;
                right: -100px;
            }

            .blob-2 {
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, #a8ff78 0%, transparent 70%);
                bottom: -150px;
                left: -150px;
                animation-delay: 7s;
            }

            .blob-3 {
                width: 400px;
                height: 400px;
                background: radial-gradient(circle, #78ffd6 0%, transparent 70%);
                top: 50%;
                left: 50%;
                animation-delay: 14s;
            }

            @keyframes blob-float {

                0%,
                100% {
                    transform: translate(0, 0);
                }

                33% {
                    transform: translate(30px, -50px);
                }

                66% {
                    transform: translate(-20px, 20px);
                }
            }

            .signup-glass-card-moder {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 650px;
                background: rgba(255, 255, 255, 0.12);
                backdrop-filter: blur(40px) saturate(180%);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 32px;
                padding: 50px 40px;
                box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
                opacity: 0;
                transform: scale(0.95);
            }

            .signup-header-moder {
                text-align: center;
                margin-bottom: 40px;
            }

            .logo-circle-moder {
                width: 80px;
                height: 80px;
                background: rgba(255, 255, 255, 0.18);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            }

            .signup-header-moder h1 {
                font-size: 32px;
                font-weight: 700;
                color: #fff;
                margin-bottom: 8px;
            }

            .signup-header-moder p {
                color: rgba(255, 255, 255, 0.8);
                font-size: 16px;
            }

            .signup-form-moder {
                margin-bottom: 30px;
            }

            .form-grid-moder {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 20px;
                margin-bottom: 24px;
            }

            .input-group-glass-moder {
                width: 100%;
            }

            .input-group-glass-moder label {
                display: block;
                color: rgba(255, 255, 255, 0.95);
                font-weight: 600;
                margin-bottom: 8px;
                font-size: 14px;
            }

            .glass-input-moder {
                width: 100%;
                padding: 16px 18px;
                background: rgba(255, 255, 255, 0.12);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 16px;
                color: #fff;
                font-size: 15px;
                transition: all 0.3s ease;
                outline: none;
            }

            .glass-input-moder::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

            .glass-input-moder:focus {
                background: rgba(255, 255, 255, 0.18);
                border-color: rgba(255, 255, 255, 0.45);
                box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
            }

            .upload-section-moder {
                margin-bottom: 24px;
            }

            .upload-section-moder label {
                display: block;
                color: rgba(255, 255, 255, 0.95);
                font-weight: 600;
                margin-bottom: 12px;
                font-size: 14px;
            }

            .upload-area-moder {
                position: relative;
                padding: 40px;
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(10px);
                border: 2px dashed rgba(255, 255, 255, 0.3);
                border-radius: 20px;
                text-align: center;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .upload-area-moder:hover {
                background: rgba(255, 255, 255, 0.12);
                border-color: rgba(255, 255, 255, 0.5);
            }

            .upload-area-moder p {
                color: rgba(255, 255, 255, 0.9);
                font-weight: 500;
                margin: 12px 0 8px;
            }

            .upload-area-moder span {
                color: rgba(255, 255, 255, 0.6);
                font-size: 13px;
            }

            .upload-area-moder input[type="file"] {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
            }

            .image-preview-moder {
                position: relative;
                margin-top: 16px;
                border-radius: 16px;
                overflow: hidden;
            }

            .image-preview-moder img {
                width: 100%;
                max-height: 200px;
                object-fit: cover;
                border-radius: 16px;
            }

            .remove-btn-moder {
                position: absolute;
                top: 12px;
                right: 12px;
                width: 36px;
                height: 36px;
                background: rgba(255, 255, 255, 0.9);
                border: none;
                border-radius: 50%;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
            }

            .remove-btn-moder:hover {
                background: #fff;
                transform: scale(1.1);
            }

            .benefits-box {
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 16px;
                padding: 20px;
                margin-bottom: 24px;
            }

            .benefits-box h3 {
                color: #fff;
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 16px;
            }

            .benefits-box ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .benefits-box li {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255, 255, 255, 0.85);
                font-size: 14px;
                margin-bottom: 12px;
            }

            .benefits-box li:last-child {
                margin-bottom: 0;
            }

            .checkbox-label-moder {
                display: flex;
                align-items: center;
                gap: 10px;
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                cursor: pointer;
                margin-bottom: 28px;
            }

            .checkbox-label-moder input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
            }

            .submit-btn-moder {
                width: 100%;
                padding: 18px;
                background: rgba(255, 255, 255, 0.95);
                color: #11998e;
                border: none;
                border-radius: 16px;
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                transition: all 0.3s ease;
                box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
            }

            .submit-btn-moder:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 40px rgba(255, 255, 255, 0.3);
            }

            .signup-footer-moder {
                text-align: center;
                padding-top: 20px;
                border-top: 1px solid rgba(255, 255, 255, 0.15);
            }

            .signup-footer-moder p {
                color: rgba(255, 255, 255, 0.8);
                font-size: 15px;
                margin-bottom: 12px;
            }

            .signup-footer-moder a {
                color: #fff;
                text-decoration: none;
                font-weight: 600;
            }

            .back-link-moder {
                display: inline-block;
                margin-top: 8px;
                color: rgba(255, 255, 255, 0.75) !important;
                font-size: 14px;
                font-weight: 500 !important;
            }

            @media (max-width: 640px) {
                .signup-glass-card-moder {
                    padding: 40px 30px;
                }

                .form-grid-moder {
                    grid-template-columns: 1fr;
                }
            }
        </style>

        <script>
            anime({
                targets: '.signup-glass-card-moder',
                scale: [0.95, 1],
                opacity: [0, 1],
                duration: 1000,
                easing: 'easeOutElastic(1, .8)',
                delay: 200
            });

            anime({
                targets: '.input-group-glass-moder',
                translateY: [30, 0],
                opacity: [0, 1],
                duration: 600,
                delay: anime.stagger(80, { start: 600 }),
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.benefits-box li',
                translateX: [-20, 0],
                opacity: [0, 1],
                duration: 500,
                delay: anime.stagger(100, { start: 1000 }),
                easing: 'easeOutExpo'
            });

            const uploadArea = document.getElementById('uploadArea');
            const fileInput = document.getElementById('memberImage');
            const imagePreview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');
            const removeBtn = document.getElementById('removeBtn');

            fileInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must be less than 5MB');
                        this.value = '';
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        imagePreview.style.display = 'block';
                        uploadArea.style.display = 'none';

                        anime({
                            targets: imagePreview,
                            scale: [0.8, 1],
                            opacity: [0, 1],
                            duration: 500,
                            easing: 'easeOutBack'
                        });
                    };
                    reader.readAsDataURL(file);
                }
            });

            removeBtn.addEventListener('click', function () {
                fileInput.value = '';
                imagePreview.style.display = 'none';
                uploadArea.style.display = 'block';
            });

            function validateSignupForm() {
                const password = document.querySelector('.member-password').value;
                const confirmPassword = document.querySelector('.confirm-password').value;
                const phone = document.querySelector('.member-phone').value;

                if (password !== confirmPassword) {
                    alert('Passwords do not match!');
                    return false;
                }

                if (password.length < 6) {
                    alert('Password must be at least 6 characters!');
                    return false;
                }

                if (phone.length < 10) {
                    alert('Please enter a valid phone number!');
                    return false;
                }

                return true;
            }
        </script>
    </body>

    <%- include('../includes/footer') %>