<%- include('../includes/header') %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/events.css" />

    <body>
        <div class="events-glass-container">
            <div class="animated-bg-events">
                <div class="gradient-orb-e orb-e-1"></div>
                <div class="gradient-orb-e orb-e-2"></div>
                <div class="gradient-orb-e orb-e-3"></div>
            </div>

            <nav class="glass-nav-e">
                <div class="nav-content-e">
                    <div class="nav-brand-e">
                        <img src="/img/favicon.png" width="35" height="35" alt="Logo">
                        <span>Events Management</span>
                    </div>
                    <div class="nav-links-e">
                        <a href="/moderator/" class="nav-link-e">Home</a>
                        <a href="/moderator/event/all" class="nav-link-e active">Events</a>
                        <a href="/moderator/logout" class="nav-link-e " onclick="return confirm('Logout?')">Logout</a>
                    </div>
                </div>
            </nav>

            <div class="main-content-e">
                <div class="glass-section-e table-section-e">
                    <div class="section-header-e">
                        <h2>Event Calendar</h2>
                        <button class="add-btn-e" id="addEventBtn">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                            </svg>
                            Create Event
                        </button>
                    </div>

                    <div class="table-wrapper-e">
                        <table class="glass-table-e">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Event Name</th>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% events.map(function(event, index){ %>
                                    <tr class="table-row-e">
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td><strong>
                                                <%= event.eventTitle %>
                                            </strong></td>
                                        <td><span class="type-badge-e">
                                                <%= event.eventType %>
                                            </span></td>
                                        <td>
                                            <%= new Date(event.eventDate).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <%= event.eventLocation %>
                                        </td>
                                        <td>
                                            <select class="status-select-e" id="<%= event._id %>">
                                                <option value="PAUSE" <%=event.eventStatus==='PAUSE' ? 'selected' : ''
                                                    %>>Pause</option>
                                                <option value="PROCESS" <%=event.eventStatus==='PROCESS' ? 'selected'
                                                    : '' %>>Active</option>
                                                <option value="DELETE" <%=event.eventStatus==='DELETE' ? 'selected' : ''
                                                    %>>Delete</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <form action="/moderator/event/<%= event._id %>" method="POST" style="display: inline;">
                                                    <button type="button" class="edit-btn-e"
                                                        onclick="window.location.href='/moderator/event/edit/<%= event._id %>'">
                                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                                            <path
                                                                d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                                        </svg>
                                                    </button>
                                                </form>
                                                <form action="/moderator/event/delete/<%= event._id %>" method="POST" style="display: inline;"
                                                    onsubmit="return confirm('Are you sure you want to delete this event?')">
                                                    <button type="submit" class="delete-btn-e">
                                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                        </svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="glass-section-e form-section-e" id="formSection" style="display: none;">
                    <div class="section-header-e">
                        <h2>Create New Event</h2>
                        <button class="close-btn-e" id="closeFormBtn">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </svg>
                        </button>
                    </div>

                    <form action="/moderator/event/create" method="POST" enctype="multipart/form-data"
                        class="event-form-e">
                        <div class="form-grid-e">
                            <div class="form-group-e full-width-e">
                                <label>Event Title *</label>
                                <input type="text" name="eventTitle" class="glass-input-e" placeholder="Conference 2024"
                                    required>
                            </div>

                            <div class="form-group-e">
                                <label>Event Date *</label>
                                <input type="date" name="eventDate" class="glass-input-e" required>
                            </div>

                            <div class="form-group-e">
                                <label>Event Type *</label>
                                <select name="eventType" class="glass-input-e">
                                    <option value="discount">
                                        discount
                                    </option>
                                    <option value="newArrival">
                                        newArrival
                                    </option>
                                    <option value="clearance">
                                        clearance
                                    </option>
                                    <option value="specialOffer">
                                        specialOffer
                                    </option>
                                    <option value="conference">
                                        conference
                                    </option>
                                </select>
                            </div>

                            <div class="form-group-e">
                                <label>Location *</label>
                                <input type="text" name="eventLocation" class="glass-input-e"
                                    placeholder="Convention Center" required>
                            </div>
                        </div>

                        <div class="form-group-e full-width-e">
                            <label>Description</label>
                            <textarea name="eventDesc" class="glass-textarea-e" rows="4"
                                placeholder="Event description..."></textarea>
                        </div>

                        <input name="eventStatus" value="PAUSE" hidden>

                        <div class="form-group-e full-width-e">
                            <label>Event Images (Max 5)</label>
                            <div class="upload-grid-e">
                                <div class="upload-box-e">
                                    <svg width="30" height="30" fill="rgba(255,255,255,0.5)" viewBox="0 0 24 24">
                                        <path
                                            d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                    <span>Upload</span>
                                    <input type="file" name="eventImage" class="file-input-e" accept="image/*">
                                </div>
                                <div class="upload-box-e">
                                    <svg width="30" height="30" fill="rgba(255,255,255,0.5)" viewBox="0 0 24 24">
                                        <path
                                            d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                    <span>Upload</span>
                                    <input type="file" name="eventImage" class="file-input-e" accept="image/*">
                                </div>
                                <div class="upload-box-e">
                                    <svg width="30" height="30" fill="rgba(255,255,255,0.5)" viewBox="0 0 24 24">
                                        <path
                                            d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                    <span>Upload</span>
                                    <input type="file" name="eventImage" class="file-input-e" accept="image/*">
                                </div>
                                <div class="upload-box-e">
                                    <svg width="30" height="30" fill="rgba(255,255,255,0.5)" viewBox="0 0 24 24">
                                        <path
                                            d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                    <span>Upload</span>
                                    <input type="file" name="eventImage" class="file-input-e" accept="image/*">
                                </div>
                                <div class="upload-box-e">
                                    <svg width="30" height="30" fill="rgba(255,255,255,0.5)" viewBox="0 0 24 24">
                                        <path
                                            d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                                    </svg>
                                    <span>Upload</span>
                                    <input type="file" name="eventImage" class="file-input-e" accept="image/*">
                                </div>
                            </div>
                        </div>

                        <div class="form-actions-e">
                            <button type="button" class="cancel-btn-e" id="cancelBtn">Cancel</button>
                            <button type="submit" class="submit-btn-e">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                                </svg>
                                <span>Create Event</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                overflow-x: hidden;
                background: #0a0e27;
                color: #fff;
            }

            .events-glass-container {
                position: relative;
                min-height: 100vh;
                padding-bottom: 40px;
            }

            .animated-bg-events {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
                z-index: 0;
            }

            .gradient-orb-e {
                position: absolute;
                border-radius: 50%;
                filter: blur(100px);
                opacity: 0.5;
                animation: float-e 25s ease-in-out infinite;
            }

            .orb-e-1 {
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, #06beb6 0%, transparent 70%);
                top: -150px;
                left: -150px;
            }

            .orb-e-2 {
                width: 450px;
                height: 450px;
                background: radial-gradient(circle, #a8ff78 0%, transparent 70%);
                bottom: -100px;
                right: -100px;
                animation-delay: 8s;
            }

            .orb-e-3 {
                width: 400px;
                height: 400px;
                background: radial-gradient(circle, #78ffd6 0%, transparent 70%);
                top: 40%;
                left: 50%;
                animation-delay: 16s;
            }

            @keyframes float-e {

                0%,
                100% {
                    transform: translate(0, 0);
                }

                33% {
                    transform: translate(50px, -70px);
                }

                66% {
                    transform: translate(-30px, 40px);
                }
            }

            .glass-nav-e {
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 1000;
                width: calc(100% - 40px);
                max-width: 1400px;
            }

            .nav-content-e {
                background: rgba(255, 255, 255, 0.12);
                backdrop-filter: blur(30px) saturate(180%);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 20px;
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            }

            .nav-brand-e {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 18px;
                font-weight: 600;
                color: #fff;
            }

            .nav-brand-e img {
                border-radius: 10px;
            }

            .nav-links-e {
                display: flex;
                gap: 8px;
            }

            .nav-link-e {
                color: rgba(255, 255, 255, 0.85);
                text-decoration: none;
                padding: 10px 20px;
                border-radius: 12px;
                font-weight: 500;
                transition: all 0.3s ease;
                font-size: 15px;
            }

            .nav-link-e:hover {
                background: rgba(255, 255, 255, 0.15);
                color: #fff;
            }

            .nav-link-e.active {
                background: rgba(255, 255, 255, 0.2);
                color: #fff;
            }

            .nav-btn-e {
                background: rgba(255, 255, 255, 0.25);
            }

            .main-content-e {
                position: relative;
                z-index: 1;
                max-width: 1400px;
                margin: 0 auto;
                padding: 100px 20px 20px;
            }

            .glass-section-e {
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(40px) saturate(180%);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 24px;
                padding: 30px;
                margin-bottom: 24px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
                opacity: 0;
                transform: translateY(30px);
            }

            .section-header-e {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
            }

            .section-header-e h2 {
                font-size: 28px;
                font-weight: 700;
                color: #fff;
            }

            .add-btn-e,
            .close-btn-e {
                padding: 12px 24px;
                background: rgba(255, 255, 255, 0.95);
                color: #11998e;
                border: none;
                border-radius: 12px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s ease;
            }

            .add-btn-e:hover,
            .close-btn-e:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 255, 255, 0.3);
            }

            .close-btn-e {
                padding: 10px;
                background: rgba(255, 255, 255, 0.2);
                color: #fff;
            }

            .table-wrapper-e {
                overflow-x: auto;
            }

            .glass-table-e {
                width: 100%;
                border-collapse: collapse;
            }

            .glass-table-e thead tr {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 12px;
            }

            .glass-table-e th {
                padding: 16px;
                text-align: left;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
            }

            .glass-table-e tbody tr {
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                transition: all 0.3s ease;
            }

            .glass-table-e tbody tr:hover {
                background: rgba(255, 255, 255, 0.05);
            }

            .glass-table-e td {
                padding: 16px;
                color: rgba(255, 255, 255, 0.85);
                font-size: 14px;
            }

            .type-badge-e {
                padding: 6px 12px;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                color: #fff;
            }

            .status-select-e {
                padding: 8px 12px;
                background: rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 8px;
                color: #fff;
                font-weight: 500;
                cursor: pointer;
                outline: none;
            }

            .form-grid-e {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
                margin-bottom: 20px;
            }

            .form-group-e {
                width: 100%;
            }

            .full-width-e {
                grid-column: 1 / -1;
            }

            .form-group-e label {
                display: block;
                color: rgba(255, 255, 255, 0.95);
                font-weight: 600;
                margin-bottom: 8px;
                font-size: 14px;
            }

            .glass-input-e,
            .glass-textarea-e {
                width: 100%;
                padding: 14px 16px;
                background: rgba(255, 255, 255, 0.12);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 12px;
                color: #fff;
                font-size: 15px;
                transition: all 0.3s ease;
                outline: none;
                font-family: inherit;
            }

            .glass-input-e::placeholder,
            .glass-textarea-e::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

            .glass-input-e:focus,
            .glass-textarea-e:focus {
                background: rgba(255, 255, 255, 0.18);
                border-color: rgba(255, 255, 255, 0.45);
                box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
            }

            .upload-grid-e {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
                gap: 12px;
            }

            .upload-box-e {
                position: relative;
                aspect-ratio: 1;
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(10px);
                border: 2px dashed rgba(255, 255, 255, 0.25);
                border-radius: 12px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .upload-box-e:hover {
                background: rgba(255, 255, 255, 0.12);
                border-color: rgba(255, 255, 255, 0.4);
            }

            .upload-box-e span {
                color: rgba(255, 255, 255, 0.7);
                font-size: 13px;
                font-weight: 500;
            }

            .file-input-e {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
            }

            .form-actions-e {
                display: flex;
                gap: 12px;
                justify-content: flex-end;
                margin-top: 24px;
            }

            .cancel-btn-e {
                padding: 14px 28px;
                background: rgba(255, 255, 255, 0.15);
                color: #fff;
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .cancel-btn-e:hover {
                background: rgba(255, 255, 255, 0.2);
            }

            .submit-btn-e {
                padding: 14px 28px;
                background: rgba(255, 255, 255, 0.95);
                color: #11998e;
                border: none;
                border-radius: 12px;
                font-weight: 700;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s ease;
                box-shadow: 0 8px 24px rgba(255, 255, 255, 0.2);
            }

            .submit-btn-e:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 32px rgba(255, 255, 255, 0.3);
            }

            .action-buttons {
                display: flex;
                gap: 8px;
                justify-content: flex-start;
            }

            .edit-btn-e,
            .delete-btn-e {
                padding: 8px;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .edit-btn-e {
                background: rgba(255, 255, 255, 0.2);
                color: #fff;
            }

            .delete-btn-e {
                background: rgba(255, 71, 71, 0.2);
                color: #ff4747;
            }

            .edit-btn-e:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: translateY(-2px);
            }

            .delete-btn-e:hover {
                background: rgba(255, 71, 71, 0.3);
                transform: translateY(-2px);
            }

            @media (max-width: 768px) {
                .nav-links-e {
                    display: none;
                }

                .section-header-e {
                    flex-direction: column;
                    gap: 16px;
                    align-items: flex-start;
                }

                .table-wrapper-e {
                    overflow-x: scroll;
                }

                .form-actions-e {
                    flex-direction: column;
                }

                .cancel-btn-e,
                .submit-btn-e {
                    width: 100%;
                    justify-content: center;
                }
            }
        </style>

        <script>
            // Entrance Animations
            anime({
                targets: '.glass-section-e',
                translateY: [30, 0],
                opacity: [0, 1],
                duration: 800,
                delay: anime.stagger(200, { start: 400 }),
                easing: 'easeOutExpo'
            });

            anime({
                targets: '.table-row-e',
                translateX: [-20, 0],
                opacity: [0, 1],
                duration: 500,
                delay: anime.stagger(50, { start: 800 }),
                easing: 'easeOutExpo'
            });

            // Toggle Form
            const addEventBtn = document.getElementById('addEventBtn');
            const formSection = document.getElementById('formSection');
            const closeFormBtn = document.getElementById('closeFormBtn');
            const cancelBtn = document.getElementById('cancelBtn');

            addEventBtn.addEventListener('click', function () {
                formSection.style.display = 'block';
                anime({
                    targets: formSection,
                    translateY: [30, 0],
                    opacity: [0, 1],
                    duration: 600,
                    easing: 'easeOutExpo'
                });
                formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            closeFormBtn.addEventListener('click', hideForm);
            cancelBtn.addEventListener('click', hideForm);

            function hideForm() {
                anime({
                    targets: formSection,
                    translateY: [0, 30],
                    opacity: [1, 0],
                    duration: 400,
                    easing: 'easeInExpo',
                    complete: function () {
                        formSection.style.display = 'none';
                    }
                });
            }

            // Status change handler
            document.querySelectorAll('.status-select-e').forEach(select => {
                select.addEventListener('change', function () {
                    anime({
                        targets: this,
                        scale: [1, 1.1, 1],
                        duration: 300,
                        easing: 'easeOutElastic(1, .6)'
                    });

                    // Here you would typically send an AJAX request to update the status
                    const eventId = this.id;
                    const newStatus = this.value;
                    console.log(`Event ${eventId} status changed to ${newStatus}`);
                });
            });

            // Upload box animations
            document.querySelectorAll('.upload-box-e').forEach(box => {
                box.addEventListener('mouseenter', function () {
                    anime({
                        targets: this.querySelector('svg'),
                        scale: [1, 1.2],
                        rotate: [0, 10],
                        duration: 300,
                        easing: 'easeOutBack'
                    });
                });

                box.addEventListener('mouseleave', function () {
                    anime({
                        targets: this.querySelector('svg'),
                        scale: [1.2, 1],
                        rotate: [10, 0],
                        duration: 300,
                        easing: 'easeOutBack'
                    });
                });
            });

            // File input change handlers
            document.querySelectorAll('.file-input-e').forEach(input => {
                input.addEventListener('change', function () {
                    if (this.files && this.files[0]) {
                        const box = this.closest('.upload-box-e');
                        box.style.background = 'rgba(56, 239, 125, 0.2)';
                        box.style.borderColor = 'rgba(56, 239, 125, 0.6)';

                        anime({
                            targets: box,
                            scale: [1, 1.05, 1],
                            duration: 500,
                            easing: 'easeOutElastic(1, .6)'
                        });
                    }
                });
            });

            // Form input animations
            document.querySelectorAll('.glass-input-e, .glass-textarea-e').forEach(input => {
                input.addEventListener('focus', function () {
                    anime({
                        targets: this,
                        scale: [1, 1.02, 1],
                        duration: 300,
                        easing: 'easeOutQuad'
                    });
                });
            });
        </script>
    </body>

    <%- include('../includes/footer') %>