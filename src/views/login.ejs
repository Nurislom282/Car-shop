<%- include('includes/header') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
  <link rel="stylesheet" type="text/css" href="/css/login.css" />

  <body>
    <div class="login-glass-container">
      <!-- Animated Background -->
      <div class="animated-bg-login">
        <div class="gradient-blob blob-1"></div>
        <div class="gradient-blob blob-2"></div>
        <div class="gradient-blob blob-3"></div>
      </div>

      <!-- Login Card -->
      <div class="login-glass-card">
        <div class="login-header">
          <div class="logo-circle">
            <img src="/img/favicon.png" width="50" height="50" alt="Logo">
          </div>
          <h1>Welcome Back</h1>
          <p>Sign in to access your admin dashboard</p>
        </div>

        <form action="/admin/login" method="POST" class="login-form">
          <div class="input-group-glass">
            <label>Username</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
              <input type="text" name="memberNick" placeholder="Enter your username" required class="glass-input" />
            </div>
          </div>

          <div class="input-group-glass">
            <label>Password</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z" />
              </svg>
              <input type="password" name="memberPassword" placeholder="Enter your password" required
                class="glass-input" />
            </div>
          </div>

          <div class="remember-forgot">
            <label class="checkbox-label">
              <input type="checkbox" id="remember">
              <span>Remember me</span>
            </label>
            <a href="#" class="forgot-link">Forgot password?</a>
          </div>

          <button type="submit" class="submit-btn">
            <span>Sign In</span>
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
            </svg>
          </button>
        </form>

        <div class="login-footer">
          <p>Don't have an account? <a href="/admin/signup">Sign up</a></p>
          <a href="/admin" class="back-link">← Back to Home</a>
        </div>
      </div>

      <!-- Decorative Elements -->
      <div class="floating-elements">
        <div class="float-element el-1"></div>
        <div class="float-element el-2"></div>
        <div class="float-element el-3"></div>
      </div>
    </div>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow: hidden;
        height: 100vh;
      }

      .login-glass-container {
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .animated-bg-login {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        z-index: 0;
      }

      .gradient-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.6;
      }

      .blob-1 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, #f093fb 0%, transparent 70%);
        top: -100px;
        left: -100px;
        animation: blob-float 20s ease-in-out infinite;
      }

      .blob-2 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, #4facfe 0%, transparent 70%);
        bottom: -150px;
        right: -150px;
        animation: blob-float 25s ease-in-out infinite reverse;
      }

      .blob-3 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, #43e97b 0%, transparent 70%);
        top: 50%;
        left: 50%;
        animation: blob-float 30s ease-in-out infinite;
      }

      @keyframes blob-float {

        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }

        33% {
          transform: translate(30px, -50px) scale(1.1);
        }

        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
      }

      .login-glass-card {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 460px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(40px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 32px;
        padding: 50px 40px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
        opacity: 0;
        transform: scale(0.9);
      }

      .login-header {
        text-align: center;
        margin-bottom: 40px;
      }

      .logo-circle {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      }

      .logo-circle img {
        border-radius: 12px;
      }

      .login-header h1 {
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
      }

      .login-header p {
        color: rgba(255, 255, 255, 0.75);
        font-size: 16px;
      }

      .login-form {
        margin-bottom: 30px;
      }

      .input-group-glass {
        margin-bottom: 24px;
      }

      .input-group-glass label {
        display: block;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 14px;
      }

      .input-wrapper {
        position: relative;
      }

      .input-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.6);
        pointer-events: none;
      }

      .glass-input {
        width: 100%;
        padding: 16px 18px 16px 50px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        color: #fff;
        font-size: 15px;
        transition: all 0.3s ease;
        outline: none;
      }

      .glass-input::placeholder {
        color: rgba(255, 255, 255, 0.5);
      }

      .glass-input:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.4);
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
      }

      .remember-forgot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
      }

      .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 14px;
        cursor: pointer;
      }

      .checkbox-label input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
      }

      .forgot-link {
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.3s ease;
      }

      .forgot-link:hover {
        color: #fff;
      }

      .submit-btn {
        width: 100%;
        padding: 18px;
        background: rgba(255, 255, 255, 0.95);
        color: #667eea;
        border: none;
        border-radius: 16px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
      }

      .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(255, 255, 255, 0.3);
      }

      .submit-btn:active {
        transform: translateY(0);
      }

      .login-footer {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      .login-footer p {
        color: rgba(255, 255, 255, 0.75);
        font-size: 15px;
        margin-bottom: 12px;
      }

      .login-footer a {
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.3s ease;
      }

      .login-footer a:hover {
        opacity: 0.8;
      }

      .back-link {
        display: inline-block;
        margin-top: 8px;
        color: rgba(255, 255, 255, 0.7) !important;
        font-size: 14px;
        font-weight: 500 !important;
      }

      .floating-elements {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      .float-element {
        position: absolute;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
      }

      .el-1 {
        width: 120px;
        height: 120px;
        top: 15%;
        left: 10%;
        animation: float-el 15s ease-in-out infinite;
      }

      .el-2 {
        width: 80px;
        height: 80px;
        top: 60%;
        right: 15%;
        animation: float-el 20s ease-in-out infinite reverse;
      }

      .el-3 {
        width: 100px;
        height: 100px;
        bottom: 20%;
        left: 20%;
        animation: float-el 18s ease-in-out infinite;
      }

      @keyframes float-el {

        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }

        50% {
          transform: translateY(-30px) rotate(180deg);
        }
      }

      @media (max-width: 640px) {
        .login-glass-card {
          padding: 40px 30px;
        }

        .login-header h1 {
          font-size: 28px;
        }
      }
    </style>

    <script>
      // Entrance Animation
      anime({
        targets: '.login-glass-card',
        scale: [0.9, 1],
        opacity: [0, 1],
        duration: 1000,
        easing: 'easeOutElastic(1, .8)',
        delay: 300
      });

      anime({
        targets: '.logo-circle',
        scale: [0, 1],
        rotate: [180, 0],
        duration: 800,
        easing: 'easeOutBack',
        delay: 500
      });

      anime({
        targets: '.input-group-glass',
        translateX: [-30, 0],
        opacity: [0, 1],
        duration: 600,
        delay: anime.stagger(100, { start: 800 }),
        easing: 'easeOutExpo'
      });

      anime({
        targets: '.submit-btn',
        translateY: [20, 0],
        opacity: [0, 1],
        duration: 600,
        delay: 1200,
        easing: 'easeOutExpo'
      });

      // Input focus animation
      document.querySelectorAll('.glass-input').forEach(input => {
        input.addEventListener('focus', function () {
          anime({
            targets: this.parentElement.querySelector('.input-icon'),
            scale: [1, 1.2, 1],
            duration: 400,
            easing: 'easeOutElastic(1, .6)'
          });
        });
      });
    </script>
  </body>

  <%- include('includes/footer') %>