<%- include('includes/header') %>

    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/cars.css">

    <body>
        <div class="page-root">
            <main class="container" style="max-width:800px;margin-top:40px">
                <section class="glass-card" style="padding:20px">
                    <h2>Edit Car</h2>
                    <form action="/admin/car/<%= car._id %>" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_id" value="<%= car._id %>" />

                        <label>Car Name</label>
                        <input name="carName" required value="<%= car.carName %>" />

                        <div class="row">
                            <div>
                                <label>Brand</label>
                                <select name="carBrand" required>
                                    <option value="">-- Select Brand --</option>
                                    <% if (brands && brands.length) { %>
                                        <% brands.forEach(function(b){ %>
                                            <option value="<%= b._id %>" <%=String(b._id)===String(car.carBrand)
                                                ? 'selected' : '' %>><%= b.BrandName %>
                                            </option>
                                            <% }) %>
                                                <% } %>
                                </select>
                            </div>
                            <div>
                                <label>Type</label>
                                <select name="carType" required>
                                    <option value="SEDAN" <%=car.carType==='SEDAN' ? 'selected' : '' %>>Sedan</option>
                                    <option value="SUV" <%=car.carType==='SUV' ? 'selected' : '' %>>SUV</option>
                                    <option value="HATCHBACK" <%=car.carType==='HATCHBACK' ? 'selected' : '' %>>Hatchback</option>
                                    <option value="COUPE" <%=car.carType==='COUPE' ? 'selected' : '' %>>Coupe</option>
                                    <option value="CONVERTIBLE" <%=car.carType==='CONVERTIBLE' ? 'selected' : '' %>>Convertible</option>
                                    <option value="WAGON" <%=car.carType==='WAGON' ? 'selected' : '' %>>Wagon</option>
                                    <option value="VAN" <%=car.carType==='VAN' ? 'selected' : '' %>>Van</option>
                                    <option value="MINIVAN" <%=car.carType==='MINIVAN' ? 'selected' : '' %>>Minivan</option>
                                    <option value="PICKUP" <%=car.carType==='PICKUP' ? 'selected' : '' %>>Pickup</option>
                                    <option value="SPORT" <%=car.carType==='SPORT' ? 'selected' : '' %>>Sport</option>
                                    <option value="LUXURY" <%=car.carType==='LUXURY' ? 'selected' : '' %>>Luxury</option>
                                    </select>
                                    </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div>
                                            <label>Transmission</label>
                                            <select name="carTransmission" required>
                                                <option value="MANUAL" <%=car.carTransmission==='MANUAL' ? 'selected' : '' %>>Manual</option>
                                                <option value="AUTO" <%=car.carTransmission==='AUTO' ? 'selected' : '' %>>Automatic</option>
                                                <option value="CVT" <%=car.carTransmission==='CVT' ? 'selected' : '' %>>CVT</option>
                                                <option value="DCT" <%=car.carTransmission==='DCT' ? 'selected' : '' %>>Dual-Clutch</option>
                                                <option value="SEMI_AUTO" <%=car.carTransmission==='SEMI_AUTO' ? 'selected' : '' %>>Semi-Automatic</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label>Fuel Type</label>
                                            <select name="carFuel" required>
                                                <option value="GREENGAS" <%=car.carFuel==='GREENGAS' ? 'selected' : '' %>>Green Gas</option>
                                                <option value="DIESEL" <%=car.carFuel==='DIESEL' ? 'selected' : '' %>>Diesel</option>
                                                <option value="PETROL" <%=car.carFuel==='PETROL' ? 'selected' : '' %>>Petrol</option>
                                                <option value="ELECTRIC" <%=car.carFuel==='ELECTRIC' ? 'selected' : '' %>>Electric</option>
                                                <option value="HYBRID" <%=car.carFuel==='HYBRID' ? 'selected' : '' %>>Hybrid</option>
                                                <option value="PLUG_IN_HYBRID" <%=car.carFuel==='PLUG_IN_HYBRID' ? 'selected' : '' %>>Plug-in Hybrid
                                                </option>
                                                <option value="CNG" <%=car.carFuel==='CNG' ? 'selected' : '' %>>CNG</option>
                                                <option value="LPG" <%=car.carFuel==='LPG' ? 'selected' : '' %>>LPG</option>
                                                <option value="HYDROGEN" <%=car.carFuel==='HYDROGEN' ? 'selected' : '' %>>Hydrogen</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div>
                                <label>Price</label>
                                <input type="number" name="carPrice" required value="<%= car.carPrice %>" />
                            </div>
                            <div>
                                <label>Left Count</label>
                                <input type="number" name="carLeftCount" required value="<%= car.carLeftCount %>" />
                            </div>
                        </div>

                        <div class="row">
                            <div>
                                <label>Discount (%)</label>
                                <input type="number" name="carDeiscount" min="0" max="100"
                                    value="<%= car.carDeiscount || 0 %>" />
                            </div>
                            <div>
                                <label>Year</label>
                                <input type="date" name="carYear" required
                                    value="<%= new Date(car.carYear).toISOString().substr(0,10) %>" />
                            </div>
                        </div>

                        <div style="margin-top:12px;display:flex;gap:8px;align-items:center">
                            <label>Replace Images (optional)</label>
                            <input type="file" name="carImage" accept="image/*" multiple />
                        </div>

                        <div style="margin-top:16px;display:flex;gap:8px">
                            <button class="btn btn-ghost" type="button"
                                onclick="window.location.href='/admin/car/all'">Cancel</button>
                            <button class="btn btn-primary" type="submit">Save</button>
                        </div>
                    </form>
                </section>
            </main>
        </div>
    </body>

    <%- include('includes/footer') %>