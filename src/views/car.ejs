<%- include('includes/header') %>
    <link rel="stylesheet" href="/css/cars.css">
    <main class="container" style="max-width:900px;margin-top:36px">
        <a href="/admin/car/all">&larr; Back to cars</a>
        <section class="glass-card" style="padding:18px;margin-top:12px">
            <h2>
                <%= car.carName %>
            </h2>
            <div style="display:flex;gap:18px;align-items:flex-start">
                <div style="flex:0 0 320px">
                    <% if (car.carImages && car.carImages.length) { %>
                        <img src="/uploads/<%= String(car.carImages[0]).replace(/^\/+/, '').replace(/^uploads\//, '') %>"
                            style="width:100%;height:auto;border-radius:8px" />
                        <% } else { %>
                            <div
                                style="width:100%;height:240px;background:#f3f3f3;display:flex;align-items:center;justify-content:center">
                                No Image</div>
                            <% } %>
                </div>
                <div style="flex:1">
                    <div style="font-size:20px;margin-bottom:8px">$<%= car.carPrice %>
                    </div>
                    <div style="color:#999;margin-bottom:12px">Type: <%= car.carType %> • State: <%= car.carState %>
                    </div>
                    <p>
                        <%= car.carDesc %>
                    </p>
                </div>
            </div>
        </section>
    </main>
    <%- include('includes/footer') %>